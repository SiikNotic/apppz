NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Token PÚBLICO de Mapbox (prefijo pk., nunca uno sk. — ver
# src/lib/mapbox.ts). Sin esta variable el mapa no carga. En producción
# (GitHub Actions) se configura como Repository variable, no como
# secret ni hardcodeado: GitHub Push Protection bloquea commitear el
# valor literal pese a ser un token público.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-public-token
